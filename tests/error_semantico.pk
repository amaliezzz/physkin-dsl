// Error 4: variable no declarada
imprimir posicion(p3) en 5;

// Error 5: variable no inicializada
numero n;
n = n + 1;

// Error 6: partícula usada en expresión
numero x = p1 + 2;

// Error 7: asignación a partícula
p1 = 5;